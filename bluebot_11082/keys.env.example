# Copy to ~/.lousta/keys.env and fill in only the ones you have. Then: chmod 600 ~/.lousta/keys.env
# This file is read by the 11082 hub only. Keys never go to the browser, logs or git.
# Local Qwen (11437) and llama (11438) need no key.

XAI_API_KEY=
XAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
