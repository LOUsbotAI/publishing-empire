# ─── AI CONTENT GENERATION ───────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
GROK_API_KEY=xai-...

# ─── AUDIO PRODUCTION ────────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_VOICE_ID=your_preferred_voice_id

# ─── VIDEO PRODUCTION ────────────────────────────────────────────────
# Optional: Pexels for stock footage
PEXELS_API_KEY=your_pexels_key

# ─── FINDAWAY VOICES (Spotify, Apple Books, Kobo, Scribd, 40+ stores) ─
FINDAWAY_API_KEY=your_findaway_key

# ─── GOOGLE PLAY BOOKS ───────────────────────────────────────────────
GOOGLE_PLAY_CLIENT_ID=your_client_id
GOOGLE_PLAY_CLIENT_SECRET=your_client_secret
GOOGLE_PLAY_REFRESH_TOKEN=your_refresh_token

# ─── DISTRIBUTION: YOUTUBE ───────────────────────────────────────────
YOUTUBE_CLIENT_ID=your_oauth_client_id
YOUTUBE_CLIENT_SECRET=your_oauth_client_secret
YOUTUBE_REFRESH_TOKEN=your_refresh_token
YOUTUBE_CHANNEL_ID=your_channel_id

# ─── DISTRIBUTION: GUMROAD ───────────────────────────────────────────
GUMROAD_ACCESS_TOKEN=your_gumroad_token

# ─── DISTRIBUTION: KDP / ACX ─────────────────────────────────────────
# KDP has no public API — uploads are handled via browser automation
KDP_EMAIL=your_amazon_email
KDP_PASSWORD=your_amazon_password

# ─── DISTRIBUTION: DRAFT2DIGITAL ─────────────────────────────────────
# Distributes to: Apple Books, B&N, Kobo, Scribd, OverDrive, Tolino, 40+ stores
# Sign up: draft2digital.com → Settings → Account
D2D_EMAIL=your_d2d_email
D2D_PASSWORD=your_d2d_password

# ─── DISTRIBUTION: PAYHIP ────────────────────────────────────────────
# Direct sales — weekly payout to PayPal/bank
# Sign up: payhip.com
PAYHIP_EMAIL=your_payhip_email
PAYHIP_PASSWORD=your_payhip_password

# ─── NOTIFICATIONS: TELEGRAM ─────────────────────────────────────────
# Book launch alerts, revenue milestones, one-tap approve/reject
# Setup: @BotFather → /newbot → copy token
#        Message your bot, GET /getUpdates to find your chat ID
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ─── PAYOUT ROUTES (reference only — no passwords stored here) ────────
# PayPal payout email (for Payhip / Gumroad):  lousta79@....
# Google Pay / AdSense:                          louie.arsovski79@....
# Stripe → CommBank BSB 062-000 (correct BSB — confirm with your bank)
# NOTE: Macquarie Bank BSB is 182-182 (NOT 82-182 — that is wrong!)

# ─── AFFILIATE PROGRAMS (adds ~30% revenue per book) ─────────────────
# Amazon Associates: https://affiliate-program.amazon.com
AMAZON_ASSOCIATE_TAG=your-tag-20
# Skillshare: https://www.skillshare.com/affiliates
SKILLSHARE_AFFILIATE_ID=your_skillshare_id
# Udemy: https://www.udemy.com/affiliate
UDEMY_AFFILIATE_ID=your_udemy_id
# Audible: https://www.audible.com/ep/affiliate-program
AUDIBLE_AFFILIATE_ID=your_audible_id

# ─── MARKETING ───────────────────────────────────────────────────────
# Twitter/X
TWITTER_API_KEY=your_key
TWITTER_API_SECRET=your_secret
TWITTER_ACCESS_TOKEN=your_token
TWITTER_ACCESS_SECRET=your_token_secret

# Mailchimp for email sequences
MAILCHIMP_API_KEY=your_mailchimp_key
MAILCHIMP_LIST_ID=your_audience_id
MAILCHIMP_SERVER_PREFIX=us1

# ─── PRIMARY PAYMENTS: LEMONSQUEEZY (direct to your bank, no Stripe) ─
# Sign up: app.lemonsqueezy.com → Settings → API
LEMONSQUEEZY_API_KEY=your_ls_api_key
LEMONSQUEEZY_STORE_ID=your_store_id
LEMONSQUEEZY_WEBHOOK_SECRET=your_ls_webhook_secret

# ─── PLATFORM DIRECT PAYOUTS (all go straight to your bank account) ──
# Amazon KDP:       kdp.amazon.com → Settings → Bank Account → AU BSB + account
# ACX/Audible:      acx.amazon.com → Settings → Payment Method → Bank Transfer
# Google Play:      play.google.com/books/publish → Payments → Payment Profile
# Findaway Voices:  findawayvoices.com → Account → Payment → Bank Account
# Gumroad:          app.gumroad.com → Settings → Payouts → Bank Account
# (All of the above deposit directly to your Australian bank — no middleman)

# ─── STRIPE (optional fallback only) ─────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...

# ─── CLOUDFLARE ──────────────────────────────────────────────────────
# Tunnel: exposes your local server to the internet
CF_TUNNEL_TOKEN=your_tunnel_token
# Worker: live edge payment receiver (https://silent-union-202e.workers.dev)
CF_WORKER_URL=https://silent-union-202e.workers.dev
# D1 database ID (for direct queries via wrangler)
CF_D1_DATABASE_ID=c8712cf4-abc9-46d2-8458-d7cbd027eafd
# Termux bridge key (shared secret between this system and phone)
BRIDGE_API_KEY=change_this_bridge_key

# ─── ADMIN + SECURITY ────────────────────────────────────────────────
ADMIN_KEY=change_this_to_a_random_secret_string
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── PAYOUT SETTINGS ─────────────────────────────────────────────────
PAYOUT_THRESHOLD_USD=50

# ─── SYSTEM ──────────────────────────────────────────────────────────
# How many books to produce per week (system will auto-schedule)
BOOKS_PER_WEEK=3
VIDEOS_PER_DAY=2
# Niches to focus on (comma-separated)
TARGET_NICHES=self-help,business,finance,health,true-crime
# Default language (ISO code — add more for international)
PRIMARY_LANGUAGE=en
ADDITIONAL_LANGUAGES=es,pt,de,fr
